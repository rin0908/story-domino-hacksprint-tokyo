{
  "name": "story-domino-hacksprint-tokyo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:connections": "node --env-file-if-exists=.env src/check-connections.mjs",
    "verify:live": "node --env-file-if-exists=.env scripts/verify-live.mjs",
    "verify:daytona": "node --env-file-if-exists=.env scripts/verify-daytona.mjs"
  },
  "dependencies": {
    "@daytona/sdk": "^0.211.2",
    "neo4j-driver": "^6.2.0"
  },
  "devDependencies": {
    "agent-browser": "^0.27.0"
  }
}
