# Enter secrets only in the local .env file. Never paste them in chat.
# Bind only to this computer; no public deployment is configured.
PORT=3210

# A unique namespace for this app's new graph data. Existing data is never deleted.
STORY_NAMESPACE=story-domino-hacksprint-tokyo-20260912
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Exact OpenAI-compatible chat/completions URL of YOUR running Nosana model.
# Do not enter a generic dashboard URL. Do not invent model names.
NOSANA_CHAT_COMPLETIONS_URL=
NOSANA_MODEL=
NOSANA_API_KEY=
# Set true only if your own endpoint is intentionally unauthenticated.
NOSANA_ALLOW_UNAUTHENTICATED=false
# openai (above complete chat/completions URL) or ollama (below /api/generate URL)
NOSANA_API_STYLE=openai
NOSANA_ENDPOINT=

# Use an existing, running Sandbox. This app never creates or deletes one.
DAYTONA_API_KEY=
DAYTONA_SANDBOX_ID=
# Optional API URL override from your Daytona environment.
DAYTONA_API_URL=
DAYTONA_TARGET=
